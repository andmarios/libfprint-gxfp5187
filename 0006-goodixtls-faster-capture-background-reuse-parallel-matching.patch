From: Rémi Leuci <github.yjifi@passmail.ovh>
Date: Sun, 15 Nov 2026 02:48:08 +0100
Subject: [PATCH] goodixtls: faster capture, background reuse, parallel matching

A verification took 0.8 s before the sensor accepted a finger, then 0.7 s from
the touch to the decision. Measured on a MateBook X Pro (firmware
GF3288_ST411SEC_APP_11034), command by command and frame by frame:

- Capture: 610 ms -> 130 ms. The vendor's activation sequence (MCU state over
  TLS, finger-detection setup, navigation frame, register reads) was replayed
  before every image and took 480 ms. Only the image command is sent now; the
  frames differ from the earlier ones by the sensor's noise, straight after a
  reset as well as on a long-lived session, and presses score the same.

- Background: a verification reuses the background and the detection baseline
  of the previous one for 60 s (boot-time clock), which makes the sensor ready
  in 1 ms instead of 800. Seven presses scored against nineteen backgrounds
  taken from 160 s before to 110 s after them show no trend with age. A
  verification that does not match, or whose image is rejected, drops the
  background, so a stale one costs one attempt at most. Enrolment always takes
  a fresh one. When a new background is needed it takes 200 ms (two
  calibration probes instead of four).

- A press that has served a capture no longer serves the next operation: with
  a reused background nothing else separated two verifications, and a finger
  resting on the sensor after an unlock would have approved the next request.
  The next operation waits for the finger to be lifted.

- Settling: the capture now starts 30-90 ms after detection, once two
  detection readings 30 ms apart no longer sink (detection fires at 65-85 % of
  the settled level, and the activation sequence no longer delays the image).

- Detection is polled every 50 ms instead of 100.

- Matching: the template views are matched on four threads (42 -> 12 ms for
  46 views) and extraction caches the gradient direction and the row maxima
  (40 -> 19 ms). Descriptors and scores are identical, byte for byte, on the
  recorded captures.

Checked on that unit: ten normal presses out of ten accepted (scores 12-49
against the 26 enrolled views alone), four presses of another finger at 0.
---
diff --git a/libfprint/drivers/goodixtls/goodix_sift.c b/libfprint/drivers/goodixtls/goodix_sift.c
index cfdcaa1c..905db6d6 100644
--- a/libfprint/drivers/goodixtls/goodix_sift.c
+++ b/libfprint/drivers/goodixtls/goodix_sift.c
@@ -105,14 +105,18 @@ gx_sift_extract (const double *img, int w, int h)
   g_autofree double *c2m = g_malloc (sizeof (double) * n);
   g_autofree double *s2m = g_malloc (sizeof (double) * n);
   g_autofree double *sal = g_malloc (sizeof (double) * n);
+  g_autofree double *gdir = g_malloc (sizeof (double) * n);
   GxSiftFeatures *f;
 
   gradients (img, gx, gy, w, h);
+  /* The gradient direction is computed once per pixel: descriptor windows
+   * overlap, and each pixel is read by about four of them. */
   for (i = 0; i < n; i++)
     {
       vx[i] = gx[i] * gx[i] - gy[i] * gy[i];
       vy[i] = 2.0 * gx[i] * gy[i];
       mag[i] = hypot (gx[i], gy[i]);
+      gdir[i] = atan2 (gy[i], gx[i]);
     }
 
   /* Smoothed orientation field. */
@@ -151,25 +155,44 @@ gx_sift_extract (const double *img, int w, int h)
   f = g_new0 (GxSiftFeatures, 1);
   f->pts = g_new0 (GxSiftPoint, GX_SIFT_MAX_PTS);
 
-  /* Pick maxima, enforcing a minimum spacing. */
-  for (k = 0; k < GX_SIFT_MAX_PTS; k++)
-    {
-      int best = -1;
-      double bv = 0.0;
-
-      for (i = 0; i < n; i++)
-        if (sal[i] > bv)
-          { bv = sal[i]; best = i; }
-      if (best < 0)
-        break;
-      x = best % w; y = best / w;
-      f->pts[f->n].x = x;
-      f->pts[f->n].y = y;
-      f->n++;
-      for (int yy = MAX (0, y - 6); yy < MIN (h, y + 7); yy++)
-        for (int xx = MAX (0, x - 6); xx < MIN (w, x + 7); xx++)
-          sal[yy * w + xx] = 0.0;
-    }
+  /* Pick maxima, enforcing a minimum spacing. Each pick is the first global
+   * maximum in raster order. The maximum of every row is cached and only the
+   * rows the suppression window touched are rescanned: rescanning the whole
+   * image for each point was a third of the extraction time. */
+  {
+    g_autofree int *row_best = g_new (int, h);   /* index of the row's maximum */
+    int dirty0 = 0, dirty1 = h;
+
+    for (k = 0; k < GX_SIFT_MAX_PTS; k++)
+      {
+        int best = -1;
+        double bv = 0.0;
+
+        for (y = dirty0; y < dirty1; y++)
+          {
+            double rv = 0.0;
+
+            row_best[y] = -1;
+            for (i = y * w; i < (y + 1) * w; i++)
+              if (sal[i] > rv)
+                { rv = sal[i]; row_best[y] = i; }
+          }
+        for (y = 0; y < h; y++)
+          if (row_best[y] >= 0 && sal[row_best[y]] > bv)
+            { bv = sal[row_best[y]]; best = row_best[y]; }
+        if (best < 0)
+          break;
+        x = best % w; y = best / w;
+        f->pts[f->n].x = x;
+        f->pts[f->n].y = y;
+        f->n++;
+        dirty0 = MAX (0, y - 6);
+        dirty1 = MIN (h, y + 7);
+        for (int yy = dirty0; yy < dirty1; yy++)
+          for (int xx = MAX (0, x - 6); xx < MIN (w, x + 7); xx++)
+            sal[yy * w + xx] = 0.0;
+      }
+  }
 
   /* Descriptors. */
   for (k = 0; k < (int) f->n; k++)
@@ -197,7 +220,7 @@ gx_sift_extract (const double *img, int w, int h)
               continue;
             if (yy < 0 || yy >= h || xx < 0 || xx >= w)
               continue;
-            ang = atan2 (gy[yy * w + xx], gx[yy * w + xx]) - a;
+            ang = gdir[yy * w + xx] - a;
             g = fmod (ang, 2 * M_PI);
             if (g < 0) g += 2 * M_PI;
             b = (int) (g / (2 * M_PI) * GX_SIFT_BINS) % GX_SIFT_BINS;
@@ -438,6 +461,72 @@ gx_sift_match_mask (const GxSiftFeatures *A, const GxSiftFeatures *B,
   return best;
 }
 
+/* Fused score: the number of capture points that AT LEAST ONE template view
+ * explains. A press often overlaps several views without covering any of them
+ * decisively; taking the best single view threw that distributed evidence
+ * away. Chance matches from a foreign finger do not accumulate the same way:
+ * they fail the geometric check.
+ *
+ * The views are independent, so they are matched on several threads; the
+ * result is the same whatever the split. */
+#define GX_FUSE_THREADS 4
+
+typedef struct
+{
+  GPtrArray            *views;
+  const GxSiftFeatures *probe;
+  gint                  next;   /* next view to match (atomic) */
+  GMutex                lock;   /* guards @seen */
+  guint8               *seen;
+} FuseJob;
+
+static gpointer
+fuse_worker (gpointer data)
+{
+  FuseJob *job = data;
+  g_autofree guint8 *mask = g_new0 (guint8, job->probe->n);
+  guint i, k;
+
+  while ((i = (guint) g_atomic_int_add (&job->next, 1)) < job->views->len)
+    gx_sift_match_mask (g_ptr_array_index (job->views, i), job->probe, mask);
+  g_mutex_lock (&job->lock);
+  for (k = 0; k < job->probe->n; k++)
+    job->seen[k] |= mask[k];
+  g_mutex_unlock (&job->lock);
+  return NULL;
+}
+
+int
+gx_sift_fused_score (GPtrArray *views, const GxSiftFeatures *probe)
+{
+  FuseJob job = { .views = views, .probe = probe };
+  GThread *helpers[GX_FUSE_THREADS - 1];
+  guint n_helpers = 0, want, i;
+  int score = 0;
+
+  job.seen = g_new0 (guint8, probe->n);
+  g_mutex_init (&job.lock);
+  want = MIN (MIN (g_get_num_processors (), GX_FUSE_THREADS), views->len);
+  /* A helper that cannot be started is not missed: the others, this thread
+   * included, take its share. */
+  for (i = 1; i < want; i++)
+    {
+      GThread *t = g_thread_try_new ("gx-match", fuse_worker, &job, NULL);
+
+      if (t)
+        helpers[n_helpers++] = t;
+    }
+  fuse_worker (&job);
+  for (i = 0; i < n_helpers; i++)
+    g_thread_join (helpers[i]);
+  g_mutex_clear (&job.lock);
+
+  for (i = 0; i < probe->n; i++)
+    score += job.seen[i];
+  g_free (job.seen);
+  return score;
+}
+
 
