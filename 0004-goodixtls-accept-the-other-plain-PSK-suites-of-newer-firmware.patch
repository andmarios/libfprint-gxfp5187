+++ b/libfprint/drivers/goodixtls/goodixtls.c
@@ -826,7 +826,8 @@
       fp_warn ("%s", err->message);
       return FALSE;
     }
-  fp_info ("TLS-PSK session up (%s)", gx_tls_ciphersuite (self->tls));
+  fp_info ("TLS-PSK session up (%s; sensor offered %s)",
