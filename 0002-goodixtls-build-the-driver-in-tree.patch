From 534d8618791b0176deaa113dd7740999b5c315c5 Mon Sep 17 00:00:00 2001
From: Marios Andreopoulos <opensource@andmarios.com>
Date: Sun, 27 Sep 2026 19:01:27 +0300
Subject: [PATCH 2/3] goodixtls: build the driver in-tree

Register goodixtls as an SPI driver next to elanspi. It needs the udev
helper (spidev enumeration) and OpenSSL (TLS-PSK channel).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libfprint/meson.build | 6 ++++++
 meson.build           | 1 +
 2 files changed, 7 insertions(+)

diff --git a/libfprint/meson.build b/libfprint/meson.build
index f11533ca..7fd79017 100644
--- a/libfprint/meson.build
+++ b/libfprint/meson.build
@@ -122,6 +122,12 @@ driver_sources = {
     'elan' : files('drivers/elan.c'),
     'elanmoc' : files('drivers/elanmoc/elanmoc.c'),
     'elanspi' : files('drivers/elanspi.c'),
+    'goodixtls' : files(
+        'drivers/goodixtls/goodixtls.c',
+        'drivers/goodixtls/goodix_sift.c',
+        'drivers/goodixtls/goodix_tls.c',
+        'drivers/goodixtls/config_pcap.c',
+    ),
     'nb1010' : files('drivers/nb1010.c'),
     'virtual_image' : files('drivers/virtual-image.c'),
     'virtual_device' : files('drivers/virtual-device.c'),
diff --git a/meson.build b/meson.build
index ab09dc1d..de78266f 100644
--- a/meson.build
+++ b/meson.build
@@ -150,6 +150,7 @@ drivers_info = {
 
     # SPI driver (non-optional if SPI is available)
     'elanspi': { 'spi': true, 'helper': ['udev'], 'optional': not have_spi },
+    'goodixtls': { 'spi': true, 'helper': ['udev', 'openssl'], 'optional': not have_spi },
 
     # Virtual drivers (test-only, optional)
     'virtual_image': { 'virtual': true, 'helper': ['virtual'], 'optional': true },
-- 
